import subprocess, time, hashlib
H="xs2a.tech26.de"
def go(path, extra=None, label=""):
    url=f"https://{H}{path}"
    cmd=["curl","-sS","-m","12","-o","body.tmp","-D","hdr.tmp",
         "-w","%{http_code}|%{size_download}|%{time_total}","-H","User-Agent: Mozilla/5.0 (research; n26-bbp-verify)",
         "-H","Accept: application/json", url]
    if extra: cmd[6:6]=extra
    out=subprocess.run(cmd,capture_output=True,text=True).stdout.strip()
    try: hdr=open("hdr.tmp").read()
    except: hdr=""
    try: body=open("body.tmp","rb").read()
    except: body=b""
    srv=[l.split(":",1)[1].strip() for l in hdr.split("\n") if l.lower().startswith("server:")]
    wa=[l.split(":",1)[1].strip() for l in hdr.split("\n") if l.lower().startswith("www-authenticate:")]
    ct=[l.split(":",1)[1].strip() for l in hdr.split("\n") if l.lower().startswith("content-type:")]
    print(f"[{label or path}] {out} server={srv} wwwauth={wa} ct={ct} md5={hashlib.md5(body).hexdigest()[:10]}")
    if body: print("    body:", body[:220].decode('utf-8','replace').replace("\n"," "))
    time.sleep(1.2)

print("=== A. production Berlin-Group API, anonymous ===")
go("/v1/berlin-group/v1/accounts", label="A1 prod /accounts noauth")
go("/v1/berlin-group/v1/consents/status", label="A2 prod /consents/status noauth")
go("/v1/berlin-group/v1/balances", label="A3 prod /balances noauth")
go("/v1/berlin-group/v1/transactions", label="A4 prod /transactions noauth")
print("=== B. production API with malformed bearer ===")
go("/v1/berlin-group/v1/accounts", extra=["-H","Authorization: Bearer invalid.probe.token"], label="B1 prod /accounts badtoken")
print("=== C. sandbox surface on production host (documented) ===")
go("/v1/berlin-group/v1/sandbox/accounts", label="C1 sandbox /accounts noauth")
go("/v1/berlin-group/v1/sandbox/consents/00000000-0000-0000-0000-000000000000", label="C2 sandbox /consents/{uuid} noauth")
print("=== D. route-existence oracle for documented POST-only sandbox helpers (GET) ===")
