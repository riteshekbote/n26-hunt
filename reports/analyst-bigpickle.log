import re,zlib,base64,sys
d=open(sys.argv[1],'rb').read()
out=[]
for m in re.finditer(rb'stream\r?\n',d):
    s=m.end(); e=d.find(b'endstream',s)
    if e<0: continue
    raw=d[s:e].strip()
    t=None
    try:
        a=raw
        if a.endswith(b'~>'): a=a[:-2]
        dec=base64.a85decode(a, adobe=False)
        t=zlib.decompress(dec)
    except Exception:
        try: t=zlib.decompress(raw)
        except Exception: t=None
    if not t: continue
    txt=[]
    for tm in re.finditer(rb'\((?:\\.|[^\\()])*\)\s*Tj|\[(?:[^\[\]]|\\.)*\]\s*TJ|\((?:\\.|[^\\()])*\)\s*\'|T\*|\bTD\b|\bTd\b',t):
        g=tm.group(0)
        if g in (b'T*',) or g.endswith(b'TD') or g.endswith(b'Td'):
            txt.append(b'\n'); continue
        for s2 in re.finditer(rb'\((?:\\.|[^\\()])*\)',g):
            txt.append(s2.group(0)[1:-1])
    if txt: out.append(b' '.join(txt))
sys.stdout.buffer.write(b'\n'.join(out))
EOF
