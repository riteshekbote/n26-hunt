Now the decisive read-only probe: is the **legacy plane N26 committed to disabling in 2022–2024** still live? My established control on this edge is *real GET route → 401 istio-envoy / bogus path → 404 len=0*, with OPTIONS as the method-agnostic control (per my own 09-26 rule that GET-404 proves nothing for a documented-POST route).
[0m$ [0mcd /tmp/opencode && cat > probe.sh <<'EOF'
#!/bin/bash
# read-only: GET + OPTIONS only, no auth, <=1.2s between requests
p(){ # host method path
  h=$1; m=$2; u=$3
  out=$(curl -s -m 20 -o /tmp/opencode/b.$$ -D - -X "$m" "https://$h$u" 2>/dev/null)
  code=$(printf '%s' "$out" | awk 'NR==1{print $2}')
  srv=$(printf '%s' "$out" | grep -i '^server:' | head -1 | tr -d '\r' | cut -d' ' -f2-)
  cl=$(printf '%s' "$out" | grep -i '^content-length:' | head -1 | tr -d '\r' | cut -d' ' -f2-)
  sz=$(wc -c < /tmp/opencode/b.$$)
  printf '%-16s %-7s %-52s -> %-4s srv=%-14s cl=%-5s body=%s\n' "$h" "$m" "$u" "$code" "${srv:--}" "${cl:--}" "$sz"
  rm -f /tmp/opencode/b.$$
  sleep 1.2
}
echo "########## POSITIVE CONTROL (known-live GET route) ##########"
p pisp.tech26.de GET  "/api/openbanking/fallback/sepa-ct/1/status"
p pisp.tech26.de OPTIONS "/api/openbanking/fallback/sepa-ct/1/status"
echo "########## NEGATIVE CONTROL (bogus path) ##########"
p pisp.tech26.de GET  "/api/this-route-does-not-exist-xyz"
echo "########## PISP legacy plane named only in pin.sh + README deprecation notice ##########"
p pisp.tech26.de GET    "/api/encryption/key"
p pisp.tech26.de GET    "/api/transactions/so"
p pisp.tech26.de OPTIONS "/api/transactions/so"
p pisp.tech26.de GET    "/oauth2/token"
p pisp.tech26.de OPTIONS "/oauth2/token"
p pisp.tech26.de GET    "/api/accounts"
p pisp.tech26.de GET    "/api/smrt/transactions"
EOF
chmod +x probe.sh && ./probe.sh
