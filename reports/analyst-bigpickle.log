import json,re
d=json.load(open('coll.json'))
paths=set(); hosts=set(); headers=set()
def walk(o):
    if isinstance(o,dict):
        if 'raw' in o and isinstance(o.get('raw'),str) and 'http' in o.get('raw','')[:8]:
            pass
        for k,v in o.items():
            if k=='url' and isinstance(v,dict):
                if 'raw' in v: 
                    m=re.match(r'https?://([^/]+)(/[^?\s]*)',v['raw'])
                    if m: hosts.add(m.group(1)); paths.add(m.group(2))
                for pv in v.get('path',[]):
                    pass
            if k=='header' and isinstance(v,list):
                for h in v:
                    if isinstance(h,dict) and 'key' in h: headers.add(h['key'])
            walk(v)
    elif isinstance(o,list):
        for i in o: walk(i)
walk(d)
print("HOSTS:"); [print("  ",h) for h in sorted(hosts)]
print("\nPATHS:"); [print("  ",p) for p in sorted(paths)]
print("\nHEADERS:"); [print("  ",h) for h in sorted(headers)]
