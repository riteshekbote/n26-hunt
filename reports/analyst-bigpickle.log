    for tm in re.finditer(rb'\((?:\\.|[^\\()])*\)\s*Tj|\[(?:[^\[\]]|\\.)*\]\s*TJ',t):
        chunk=tm.group(0)
        for s2 in re.finditer(rb'\((?:\\.|[^\\()])*\)',chunk):
            txt.append(s2.group(0)[1:-1])
    if txt: out.append(b' '.join(txt))
sys.stdout.buffer.write(b'\n'.join(out))
EOF
