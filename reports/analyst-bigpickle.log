#!/bin/bash
p(){ h=$1; u=$2
  out=$(curl -s -m 20 -o /tmp/opencode/b.$$ -D - "https://$h$u" 2>/dev/null)
  code=$(printf '%s' "$out" | awk 'NR==1{print $2}')
  srv=$(printf '%s' "$out" | grep -i '^server:' | head -1 | tr -d '\r' | cut -d' ' -f2-)
  ct=$(printf '%s' "$out" | grep -i '^content-type:' | head -1 | tr -d '\r' | cut -d' ' -f2-)
  sz=$(wc -c < /tmp/opencode/b.$$)
  printf '%-16s %-58s -> %-4s srv=%-13s ct=%-18s body=%s\n' "$h" "$u" "$code" "${srv:--}" "${ct:--}" "$sz"
  rm -f /tmp/opencode/b.$$; sleep 1.2
}
